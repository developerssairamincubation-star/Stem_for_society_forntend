# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RZPY_KEYID=

# Backend API base URL. Defaults to http://localhost:3001 when unset,
# which will not resolve for deployed visitors - always set this in prod.
VITE_BACKEND_URL=

# --- Observability (Sentry) -------------------------------------------------
# Leave VITE_SENTRY_DSN empty to disable error reporting entirely; the app
# runs exactly the same, it just stops sending events.
# Free tier: 5k errors + 50 replays per month, 1 user.
# Create a project at https://sentry.io -> React, then paste its DSN here.
VITE_SENTRY_DSN=

# Distinguishes environments in the Sentry UI (production / staging / preview).
VITE_SENTRY_ENVIRONMENT=

# Share of requests traced for performance. 0.1 = 10%, which keeps a busy
# site inside the free quota. Set to 0 to turn tracing off.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Session Replay records a video-like playback of the session that errored.
# Off by default because the free tier only allows 50 replays per month.
VITE_SENTRY_REPLAY=false

# Ties errors to a build so you can see which deploy introduced them.
# In CI: VITE_APP_VERSION=$(git rev-parse --short HEAD)
VITE_APP_VERSION=

# Sends X-Correlation-Id on every API request so a frontend error can be
# matched to a backend log line. Leave off until the API has that header in
# its CORS allowedHeaders - otherwise preflight fails and every call breaks.
VITE_SEND_CORRELATION_HEADER=false

# --- Redesigned SFS UI (header, footer, home, institutions, community, campus ambassador) -------------
# All optional: each falls back to an existing page of the platform.
# "Explore Network Beyond Campus" (separate website). Default https://networkingbeyondcampus.com/
VITE_NETWORK_URL=
# Partner With Us. Default /partner-institution-signup
VITE_PARTNER_URL=
# Scientific Communications (blog). Default /blog
VITE_BLOG_URL=
# Campus Ambassador "Apply Now". Default /campus-ambassador-booking
VITE_CA_REGISTRATION_URL=
# Footer partner/admin sign-in. Defaults /partner/signin and /admin/signin
VITE_PARTNER_LOGIN_URL=
VITE_ADMIN_LOGIN_URL=
# Institutions enquiry form: JSON POST endpoint. Empty = opens a pre-filled email
VITE_ENQUIRY_ENDPOINT=
# Footer newsletter: JSON { email } POST endpoint. Empty = opens a pre-filled email
VITE_NEWSLETTER_ENDPOINT=
# WhatsApp community invite link and social profiles (defaults are the current SFS profiles)
VITE_WHATSAPP_COMMUNITY_URL=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_X=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_YOUTUBE=
VITE_COMMUNITY_X_URL=
VITE_COMMUNITY_INSTAGRAM_URL=
VITE_COMMUNITY_YOUTUBE_URL=
